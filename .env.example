# Local-first defaults. Set APEX_ENV=production and a strong API key when deployed.
APEX_ENV=development
APEX_API_KEY=
APEX_ARTIFACT_DIR=artifacts
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=apex-customer-churn
APEX_REGISTERED_MODEL_NAME=APEXCustomerChurn
APEX_ENABLE_MODEL_REGISTRY=true
APEX_PROMOTION_MIN_IMPROVEMENT=0.002
